# Database Configuration
DB_HOST=your-production-host
DB_PORT=5432
DB_USERNAME=your-production-user
DB_PASSWORD=your-production-password
DB_DATABASE=taskmanager
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=true

# Application
PORT=3000
NODE_ENV=production

# JWT Configuration (expiration in seconds: 3600 = 1 hour, 604800 = 7 days)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-32-chars
JWT_REFRESH_EXPIRATION=604800

# CORS Configuration - Production
# Add your production frontend domains here (comma-separated)
CORS_ORIGIN=https://taskapi.mahabub.bd,https://www.taskapi.mahabub.bd

# File Upload Configuration
MAX_FILE_SIZE=10485760
STORAGE_PROVIDER=s3

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-production-bucket-name
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# ZeptoMail SMTP Configuration
ZEPOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPOMAIL_SMTP_PORT=587
ZEPOMAIL_SMTP_SECURE=false
ZEPOMAIL_SMTP_USER=your-zeptomail-email@example.com
ZEPOMAIL_SMTP_PASS=your-zeptomail-password
ZEPOMAIL_FROM_EMAIL=noreply@yourdomain.com
ZEPOMAIL_FROM_NAME=Project & Task Management

# Frontend URL (for email links)
FRONTEND_URL=https://taskmanager.mahabub.bd
